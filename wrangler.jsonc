{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hackathon",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "ACCOUNTS_DB",
			"database_name": "hackathon-accounts",
			"database_id": "e00e1f60-4881-4f06-bcce-35ab24795bcf"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "MODELS",
			"id": "f9a226bde3ae4eab956827524b9ceae5"
		}
	],
	"workflows": [
		{
			"name": "research-workflow",
			"binding": "RESEARCH_WORKFLOW",
			"class_name": "ResearchWorkflow"
		}
	]
}