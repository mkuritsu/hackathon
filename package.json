{
	"name": "hackathon",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
