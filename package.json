	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.46.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.7.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.3",
		"globals": "^17.7.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"wrangler": "^4.113.0"
